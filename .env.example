# SmartSpend AI - Environment Variables
# Copy this to .env and fill with your actual values

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartspend_ai
DB_USER=root
DB_PASSWORD=your_mysql_password

# Full SQLAlchemy URI (auto-built if not set)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smartspend_ai

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Mail (for password reset - optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=noreply@smartspend.ai

# OCR (for receipt scanning - optional)
TESSERACT_CMD=tesseract

# Upload limits
MAX_CONTENT_LENGTH_MB=16
UPLOAD_FOLDER=uploads

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
